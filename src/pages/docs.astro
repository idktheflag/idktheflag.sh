---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { groupDocs, sortDocs } from '../lib/docs.ts';

const docs = sortDocs(await getCollection('docs', ({ data }) => !data.draft));
const categories = groupDocs(docs);
---

<Base title="Docs" description="Documentation for idktheflag.">
  <section class="docs">
    <div class="container docs__grid">
      <aside class="docs__side">
        <nav class="docs__nav" aria-label="Docs Navigation">
          <span class="docs__nav-label">Docs</span>
          <div class="docs-search">
            <input
              type="search"
              id="docSearchInput"
              placeholder="Filter docs... (/)"
              aria-label="Filter documentation"
            />
          </div>
          {
            categories.length > 0 ? (
              categories.map((category) => (
                <details class="docs__category" open>
                  <summary>{category.title}</summary>
                  <ul>
                    {category.docs.map((doc) => (
                      <li class="doc-item" data-title={doc.data.title.toLowerCase()}>
                        <a href={`/docs/${doc.id}/`}>{doc.data.title}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              ))
            ) : (
              <p class="docs__empty">No docs yet.</p>
            )
          }
          <p class="docs__empty is-hidden" id="noDocsResults" style="margin-top:12px;">No matching documentation found.</p>
        </nav>
      </aside>

      <div class="docs__main">
        <header class="docs__header">
          <h1 class="docs__title">Docs</h1>
          {
            docs[0] ? (
              <p class="lead">
                Pick a doc from the sidebar, or start with <a href={`/docs/${docs[0].id}/`}>{docs[0].data.title}</a>.
              </p>
            ) : (
              <p class="lead">Add markdown files under <code>src/docs</code> to publish docs here.</p>
            )
          }
        </header>
      </div>
    </div>
  </section>
</Base>

<script>
  const filterInput = document.getElementById('docSearchInput') as HTMLInputElement | null;
  const docItems = Array.from(document.querySelectorAll<HTMLLIElement>('.doc-item'));
  const categoryDetails = Array.from(document.querySelectorAll<HTMLDetailsElement>('.docs__category'));
  const noDocsResults = document.getElementById('noDocsResults');

  filterInput?.addEventListener('input', () => {
    const q = filterInput.value.toLowerCase().trim();
    let totalVisible = 0;
    categoryDetails.forEach((cat) => {
      let catHasVisible = false;
      const items = Array.from(cat.querySelectorAll<HTMLLIElement>('.doc-item'));
      items.forEach((item) => {
        const title = item.getAttribute('data-title') || '';
        const match = !q || title.includes(q);
        item.style.display = match ? '' : 'none';
        if (match) {
          catHasVisible = true;
          totalVisible++;
        }
      });
      cat.style.display = catHasVisible ? '' : 'none';
      if (q && catHasVisible) cat.open = true;
    });
    if (noDocsResults) {
      noDocsResults.classList.toggle('is-hidden', !q || totalVisible > 0);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== filterInput && !['INPUT', 'TEXTAREA'].includes((document.activeElement as HTMLElement)?.tagName)) {
      e.preventDefault();
      filterInput?.focus();
    }
  });
</script>

<style>
  .docs {
    padding-block: clamp(40px, 7vw, 80px) clamp(48px, 8vw, 90px);
  }
  .docs__grid {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 56px;
    align-items: start;
  }
  .docs__side {
    position: sticky;
    top: 88px;
  }
  .docs__nav-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .docs-search {
    margin-bottom: 14px;
  }
  .docs-search input {
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 8px 12px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  .docs-search input:focus {
    outline: none;
    border-color: var(--crimson);
  }
  .docs-search input:focus-visible {
    outline: 2px solid var(--crimson-bright);
    outline-offset: 2px;
  }
  .docs__category {
    border-left: 1px solid var(--border);
  }
  .docs__category + .docs__category {
    margin-top: 14px;
  }
  .docs__category summary {
    cursor: pointer;
    list-style: none;
    padding: 6px 14px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text);
  }
  .docs__category summary::-webkit-details-marker {
    display: none;
  }
  .docs__category summary::before {
    content: '+';
    display: inline-block;
    width: 1.2em;
    color: var(--crimson-bright);
  }
  .docs__category[open] summary::before {
    content: '-';
  }
  .docs__nav ul {
    list-style: none;
    padding: 0;
  }
  .docs__nav a {
    display: block;
    padding: 6px 14px 6px 32px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: 0.88rem;
    color: var(--muted);
    transition: color 0.16s var(--ease), border-color 0.16s var(--ease);
  }
  .docs__nav a:hover {
    color: var(--text);
  }
  .docs__empty {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .docs__title {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-top: 12px;
  }
  .docs__header a {
    color: var(--crimson-bright);
  }

  @media (max-width: 880px) {
    .docs__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .docs__side {
      position: static;
    }
  }
</style>
