---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const categories = ['All', ...Array.from(new Set(posts.map((p) => p.data.category)))];
const fmtDate = (d: Date) => d.toISOString().split('T')[0];
---

<Base
  title="Blog"
  description="Writeups, recaps, and notes from the idktheflag CTF team."
>
  <section class="page-head">
    <div class="container">
      <h1 class="page-head__title">The blog.</h1>
      
      <div class="filter-bar">
        <div class="search-wrap">
          <input
            type="search"
            id="blogSearch"
            placeholder="Search writeups by title, author, or category... (/)"
            aria-label="Search blog posts"
          />
        </div>
        <div class="category-pills" id="categoryPills">
          {
            categories.map((cat, i) => (
              <button
                type="button"
                class:list={['pill-btn', i === 0 && 'is-active']}
                data-category={cat}
              >
                {cat}
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      {
        posts.length > 0 ? (
          <div class="blog-list" id="blogList">
            {posts.map((post) => (
              <a
                class="blog-item"
                href={`/blog/${post.id}/`}
                data-title={post.data.title.toLowerCase()}
                data-author={post.data.author.toLowerCase()}
                data-category={post.data.category}
              >
                <span class="blog-item__date">{fmtDate(post.data.date)}</span>
                <span class="blog-item__separator">—</span>
                <span class="blog-item__title">{post.data.title}</span>
                <span class="blog-item__separator">—</span>
                <span class="blog-item__author">{post.data.author}</span>
              </a>
            ))}
            <p class="no-results is-hidden" id="noResults">No matching writeups found.</p>
          </div>
        ) : (
          <p class="lead" style="margin-top:20px">
            More posts coming soon.
          </p>
        )
      }
    </div>
  </section>
</Base>

<script>
  const searchInput = document.getElementById('blogSearch') as HTMLInputElement | null;
  const pillsContainer = document.getElementById('categoryPills');
  const blogList = document.getElementById('blogList');
  const noResults = document.getElementById('noResults');

  if (blogList && searchInput && pillsContainer) {
    const items = Array.from(blogList.querySelectorAll<HTMLAnchorElement>('.blog-item'));
    const pillButtons = Array.from(pillsContainer.querySelectorAll<HTMLButtonElement>('.pill-btn'));
    let activeCat = 'All';

    const filterPosts = () => {
      const query = searchInput.value.toLowerCase().trim();
      let visibleCount = 0;

      items.forEach((item) => {
        const title = item.getAttribute('data-title') || '';
        const author = item.getAttribute('data-author') || '';
        const category = item.getAttribute('data-category') || '';

        const matchesCat = activeCat === 'All' || category === activeCat;
        const matchesQuery = !query || title.includes(query) || author.includes(query) || category.toLowerCase().includes(query);

        if (matchesCat && matchesQuery) {
          item.classList.remove('is-hidden');
          visibleCount++;
        } else {
          item.classList.add('is-hidden');
        }
      });

      if (noResults) {
        noResults.classList.toggle('is-hidden', visibleCount > 0);
      }
    };

    searchInput.addEventListener('input', filterPosts);

    pillButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        pillButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        activeCat = btn.getAttribute('data-category') || 'All';
        filterPosts();
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput && !['INPUT', 'TEXTAREA'].includes((document.activeElement as HTMLElement)?.tagName)) {
        e.preventDefault();
        searchInput.focus();
      }
    });
  }
</script>

<style>
  .page-head {
    padding-block: clamp(48px, 8vw, 92px) 16px;
  }
  .page-head__title {
    font-size: clamp(2rem, 5vw, 3.2rem);
  }
  .filter-bar {
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .search-wrap input {
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    transition: border-color 0.16s var(--ease);
  }
  .search-wrap input:focus {
    outline: none;
    border-color: var(--crimson);
  }
  .search-wrap input:focus-visible {
    outline: 2px solid var(--crimson-bright);
    outline-offset: 2px;
  }
  .category-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .pill-btn {
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 6px 14px;
    border-radius: 99px;
    transition: background 0.16s var(--ease), color 0.16s var(--ease), border-color 0.16s var(--ease);
  }
  .pill-btn:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }
  .pill-btn.is-active {
    background: var(--crimson-soft);
    border-color: var(--crimson-line);
    color: var(--crimson-bright);
  }

  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 24px;
  }
  .blog-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 20px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text-dim);
    transition: border-color 0.18s var(--ease), background 0.18s var(--ease), color 0.18s var(--ease);
    text-decoration: none;
  }
  .blog-item:hover {
    border-color: var(--crimson-line);
    background: var(--surface-hover);
    color: var(--text);
  }
  .blog-item__date {
    color: var(--muted);
    white-space: nowrap;
  }
  .blog-item__title {
    color: var(--text);
    font-weight: 500;
    flex-grow: 1;
  }
  .blog-item__author {
    color: var(--crimson-bright);
    white-space: nowrap;
  }
  .blog-item__separator {
    color: var(--border-strong);
  }
  .is-hidden {
    display: none !important;
  }
  .no-results {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    margin-top: 12px;
  }

  @media (max-width: 680px) {
    .blog-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      padding: 16px;
    }
    .blog-item__separator {
      display: none;
    }
    .blog-item__title {
      width: 100%;
    }
  }
</style>
