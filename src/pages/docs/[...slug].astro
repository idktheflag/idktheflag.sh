---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { getDocCategory, groupDocs, sortDocs } from '../../lib/docs.ts';

export async function getStaticPaths() {
  const docs = await getCollection('docs', ({ data }) => !data.draft);
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
const docs = sortDocs(await getCollection('docs', ({ data }) => !data.draft));
const categories = groupDocs(docs);
const activeCategory = getDocCategory(doc);
const activeCategoryTitle = activeCategory.charAt(0).toUpperCase() + activeCategory.slice(1);
---

<Base title={doc.data.title} description={doc.data.description ?? doc.data.title}>
  <section class="docs">
    <div class="container docs__grid">
      <aside class="docs__side">
        <nav class="docs__nav" aria-label="Docs Navigation">
          <a class="docs__home" href="/docs">Docs</a>
          <div class="docs-search">
            <input
              type="search"
              id="docSearchInput"
              placeholder="Filter docs... (/)"
              aria-label="Filter documentation"
            />
          </div>
          {
            categories.map((category) => (
              <details class="docs__category" open>
                <summary>{category.title}</summary>
                <ul>
                  {category.docs.map((entry) => (
                    <li class="doc-item" data-title={entry.data.title.toLowerCase()}>
                      <a class:list={[entry.id === doc.id && 'is-active']} href={`/docs/${entry.id}/`}>
                        {entry.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ))
          }
          <p class="docs__empty is-hidden" id="noDocsResults" style="margin-top:12px;">No matching documentation found.</p>
        </nav>
      </aside>

      <article class="docs__main">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/docs">Docs</a>
          <span class="sep">/</span>
          <span>{activeCategoryTitle}</span>
          <span class="sep">/</span>
          <span class="current">{doc.data.title}</span>
        </nav>

        <header class="docs__header">
          <h1 class="docs__title">{doc.data.title}</h1>
          {doc.data.description && <p class="lead">{doc.data.description}</p>}
        </header>

        <div class="prose docs__prose">
          <Content />
        </div>
      </article>
    </div>
  </section>
</Base>

<script>
  const filterInput = document.getElementById('docSearchInput') as HTMLInputElement | null;
  const categoryDetails = Array.from(document.querySelectorAll<HTMLDetailsElement>('.docs__category'));
  const noDocsResults = document.getElementById('noDocsResults');

  filterInput?.addEventListener('input', () => {
    const q = filterInput.value.toLowerCase().trim();
    let totalVisible = 0;
    categoryDetails.forEach((cat) => {
      let catHasVisible = false;
      const items = Array.from(cat.querySelectorAll<HTMLLIElement>('.doc-item'));
      items.forEach((item) => {
        const title = item.getAttribute('data-title') || '';
        const match = !q || title.includes(q);
        item.style.display = match ? '' : 'none';
        if (match) {
          catHasVisible = true;
          totalVisible++;
        }
      });
      cat.style.display = catHasVisible ? '' : 'none';
      if (q && catHasVisible) cat.open = true;
    });
    if (noDocsResults) {
      noDocsResults.classList.toggle('is-hidden', !q || totalVisible > 0);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement !== filterInput && !['INPUT', 'TEXTAREA'].includes((document.activeElement as HTMLElement)?.tagName)) {
      e.preventDefault();
      filterInput?.focus();
    }
  });
</script>

<style>
  .docs {
    padding-block: clamp(40px, 7vw, 80px) clamp(48px, 8vw, 90px);
  }
  .docs__grid {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 56px;
    align-items: start;
  }
  .docs__side {
    position: sticky;
    top: 88px;
  }
  .docs__home {
    display: block;
    margin-bottom: 10px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .docs__home:hover {
    color: var(--text);
  }
  .docs-search {
    margin-bottom: 14px;
  }
  .docs-search input {
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 8px 12px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  .docs-search input:focus {
    outline: none;
    border-color: var(--crimson);
  }
  .docs-search input:focus-visible {
    outline: 2px solid var(--crimson-bright);
    outline-offset: 2px;
  }
  .docs__category {
    border-left: 1px solid var(--border);
  }
  .docs__category + .docs__category {
    margin-top: 14px;
  }
  .docs__category summary {
    cursor: pointer;
    list-style: none;
    padding: 6px 14px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text);
  }
  .docs__category summary::-webkit-details-marker {
    display: none;
  }
  .docs__category summary::before {
    content: '+';
    display: inline-block;
    width: 1.2em;
    color: var(--crimson-bright);
  }
  .docs__category[open] summary::before {
    content: '-';
  }
  .docs__nav ul {
    list-style: none;
    padding: 0;
  }
  .docs__nav a {
    text-decoration: none;
  }
  .docs__nav li a {
    display: block;
    padding: 6px 14px 6px 32px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: 0.88rem;
    color: var(--muted);
    transition: color 0.16s var(--ease), border-color 0.16s var(--ease);
  }
  .docs__nav li a:hover {
    color: var(--text);
  }
  .docs__nav li a.is-active {
    color: var(--crimson-bright);
    border-left-color: var(--crimson);
  }
  .docs__empty {
    font-size: 0.88rem;
    color: var(--muted);
  }
  .breadcrumbs {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .breadcrumbs a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.16s var(--ease);
  }
  .breadcrumbs a:hover {
    color: var(--crimson-bright);
  }
  .breadcrumbs .sep {
    color: var(--faint);
  }
  .breadcrumbs .current {
    color: var(--text);
  }
  .docs__header {
    margin-bottom: 28px;
  }
  .docs__title {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-top: 12px;
  }

  @media (max-width: 880px) {
    .docs__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .docs__side {
      position: static;
    }
  }
</style>
