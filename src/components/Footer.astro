---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__bottom">
      <span class="note">&copy; {year} idktheflag. All rights reserved.</span>
      <a class="note site-footer__link" href="https://ctftime.org/team/419270" target="_blank" rel="noopener noreferrer">CTFtime</a>
      <a class="note site-footer__link" href="https://github.com/idktheflag/" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="note site-footer__link" href="https://www.linkedin.com/company/idktheflag" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a class="note site-footer__link" href="/contact/">Contact us</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: 28px;
    margin-top: 32px;
  }
  .site-footer__bottom {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
  }
  .site-footer__link {
    color: var(--crimson-bright);
    text-decoration: none;
    transition: color 0.16s var(--ease);
  }
  .site-footer__link:hover {
    color: var(--crimson);
  }
</style>
